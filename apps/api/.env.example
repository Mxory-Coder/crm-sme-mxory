# ─── Copy this to .env and fill in values ────────────────────────────────────
# Generate secrets with: openssl rand -hex 64  (JWT)  /  openssl rand -hex 32  (encryption)

NODE_ENV=development
PORT=3001

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://smeconnect:smeconnect_dev@localhost:5432/smeconnect

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── Encryption (for Twilio/Meta tokens stored in DB) ────────────────────────
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX

# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE
OPENAI_API_KEY=sk-REPLACE

# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACREPLACE
TWILIO_AUTH_TOKEN=REPLACE
TWILIO_WEBHOOK_BASE_URL=https://api.yourdomain.com

# ─── SendGrid ─────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.REPLACE
SENDGRID_INBOUND_PARSE_DOMAIN=inbound.yourdomain.com

# ─── Meta (Facebook / Instagram) ──────────────────────────────────────────────
META_APP_ID=REPLACE
META_APP_SECRET=REPLACE
META_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_RANDOM_STRING

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=smeconnect
MINIO_SECRET_KEY=smeconnect_dev
MINIO_BUCKET_DOCUMENTS=documents

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE

# ─── App URLs ─────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
WIDGET_CDN_URL=http://localhost:5173

# ─── Exchange Rates ───────────────────────────────────────────────────────────
OPEN_EXCHANGE_RATES_APP_ID=REPLACE
FX_REFRESH_INTERVAL_HOURS=4
